# 任意 OpenAI 兼容服务；换成你自己的网关地址、模型 ID 和密钥。
LA_BASE_URL=https://your-gateway.example/v1
LA_MODEL=your-model-id
# 在本机填写，不要提交或发到聊天中。
LA_API_KEY=
# 第三方网关协议需验证；支持 Responses 时可改 responses。
LA_PROTOCOL=chat_completions
# agent=始终走完整 Agent；auto=简单问题直答/固定检索，多模态、反馈和位置引用走 Agent。
LA_ROUTE_POLICY=agent
# 可选：MCP 只读服务器默认资料空间（ID 或名称）；也可用 --space 覆盖。
# LA_MCP_SPACE=
# 正文草稿流式默认关闭；目标网关/型号验证后显式开启。进度SSE不受此项影响。
# 当前已验证上述网关 gpt-6.1-sol 的 Chat Completions 流式。
LA_STREAM_ANSWER=false
LA_DATA_ROOT=./data
# 对外试用：填一个口令，页面和接口都要先登录；留空则只有本机能访问，行为不变。
# 生成：python3 -c 'import secrets; print(secrets.token_urlsafe(9))'
LA_ACCESS_TOKEN=
# 监听地址；只在本机用就保持 127.0.0.1，放到服务器上由容器直接监听 0.0.0.0。
LA_HOST=127.0.0.1
LA_TIMEOUT_SECONDS=90
LA_MAX_STEPS=8
LA_ENABLE_VISION=true
LA_MAX_IMAGES_PER_TURN=3

# 本地上下文工程预算，未验证为网关窗口；UTF-8代理估算，不是精确token。
LA_CONTEXT_BUDGET_TOKENS=65536
LA_CONTEXT_OUTPUT_RESERVE_TOKENS=4096
LA_CONTEXT_HEADROOM_TOKENS=4096
# 默认跟随本轮图片上限；填写时不得小于 LA_MAX_IMAGES_PER_TURN。
# LA_MAX_CONTEXT_IMAGES=3
LA_CONTEXT_IMAGE_ALLOWANCE=4096
LA_CONTEXT_MAX_REQUEST_BYTES=67108864
# 默认仅预留输出；网关确实支持后才启用相应字段，不自动探测/重试。
# chat_completions: max_tokens 或 max_completion_tokens；responses: max_output_tokens。
LA_OUTPUT_TOKEN_FIELD=none

# 历史摘要：只在预算压力与新的覆盖范围同时满足时调用，最多每轮一次。
LA_ENABLE_CONTEXT_SUMMARY=true
LA_SUMMARY_INPUT_BUDGET_TOKENS=16384
LA_SUMMARY_TIMEOUT_SECONDS=30
LA_SUMMARY_MIN_NEW_TURNS=4
LA_SUMMARY_KEEP_RECENT_TURNS=3

# 音视频需要系统 ffmpeg/ffprobe；ASR默认关闭，可使用已有字幕。
# 本地CPU：uv sync --extra dev --extra asr，然后设 local；模型首次使用需下载。
LA_ASR_PROVIDER=disabled
LA_ASR_MODEL=base
# 兼容API：将 provider 改为 compatible；model改为该服务支持时间戳的型号（如 whisper-1）。
# 使用独立密钥，不默认复用聊天中转服务。兼容服务必须返回 verbose_json.segments。
LA_ASR_BASE_URL=https://api.openai.com/v1
LA_ASR_API_KEY=

# 整课导入：默认2 GiB、4小时、最高4K。API与处理进程使用同一配置。
LA_MEDIA_MAX_BYTES=2147483648
LA_MEDIA_MAX_SECONDS=14400
# 核心区间之外最多各读取5秒上下文；改变切分方案将创建新转写任务。
LA_ASR_LOCAL_PART_SECONDS=300
LA_ASR_API_PART_SECONDS=60
LA_ASR_CONTEXT_SECONDS=5

# 多语言检索：hybrid=BM25+向量RRF；默认未配置向量时明确退回BM25。
LA_RETRIEVAL_MODE=hybrid
# 本地：ollama pull bge-m3，然后改为 ollama；在网页点击“准备语义检索”。
LA_EMBEDDING_PROVIDER=disabled
LA_EMBEDDING_BASE_URL=http://localhost:11434
LA_EMBEDDING_MODEL=bge-m3:latest
LA_EMBEDDING_TIMEOUT_SECONDS=30
# 云端向量：provider=compatible，URL含/v1，填写该服务的向量模型和独立key。
LA_EMBEDDING_API_KEY=

# 可选：只读评测页面读取的报告根目录；默认 LA_DATA_ROOT/evaluations。
# LA_EVALUATION_ROOT=./data/evaluations
